+/// Bots the account owns (`bots.getAdminedBots`), with `TelegramUser.subscriberCount` = monthly active users.
+func _internal_adminedBots(account: Account) -> Signal<[Peer], NoError> {
+    let accountPeerId = account.peerId
+    return account.network.request(Api.functions.bots.getAdminedBots())
+    |> map(Optional.init)
+    |> `catch` { _ -> Signal<[Api.User]?, NoError> in
+        return .single(nil)
+    }
+    |> mapToSignal { result -> Signal<[Peer], NoError> in
+        guard let result else {
+            return .single([])
+        }
+        return account.postbox.transaction { transaction -> [Peer] in
+            updatePeers(transaction: transaction, accountPeerId: accountPeerId, peers: AccumulatedPeers(users: result))
+            return result.compactMap { transaction.getPeer($0.peerId) }
+        }
+    }
+}
